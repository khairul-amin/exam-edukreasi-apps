<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Tambahkan app:endIconMode="password_toggle" untuk icon mata -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan Token Pengawas"
        app:endIconMode="password_toggle"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <!-- Tambahkan textCapCharacters untuk meminta keyboard mode kapital -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_proctor_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword|textCapCharacters" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Minta bantuan pengawas jika Anda keluar aplikasi secara tidak sengaja."
        android:textSize="12sp"
        android:textColor="#757575" />

</LinearLayout>